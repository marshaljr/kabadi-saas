# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# Full Postgres connection string. Must authenticate as a
# non-superuser, non-table-owner role for RLS to actually apply
# (see migrations/0008_rls_policies.sql). Typically:
#   postgres://kabadi_app:<password>@<host>:5432/kabadi
DATABASE_URL=postgres://kabadi_app:changeme@localhost:5432/kabadi_saas

# Only used by `npm run migrate`, which needs DDL rights. Point this
# at a migration-owner role, separate from the app's runtime role
# above. If you only have one Postgres user for local dev, it's fine
# for these to be the same connection string.
DATABASE_MIGRATION_URL=postgres://kabadi_migrator:changeme@localhost:5432/kabadi_saas

DATABASE_APP_ROLE=kabadi_app

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-value

JWT_ACCESS_TOKEN_TTL_SECONDS=28800

DEFAULT_TRIAL_DAYS=14

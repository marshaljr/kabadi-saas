{
  "name": "kabadi-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS platform for Kabadi/Khabar scrap collection businesses in Nepal",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "frontend:typecheck": "tsc -p frontend/tsconfig.json --noEmit",
    "frontend:build": "vite build --config frontend/vite.config.ts",
    "test": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs --test tests/*.test.ts tests/integration/*.test.ts",
    "migrate": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "dev": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs watch src/server.ts"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.4"
  }
}
